<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <add name="StudentDb"
             connectionString="server=localhost;port=3306;user=root;password=;database=student_management;SslMode=None;AllowPublicKeyRetrieval=True;"
             providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>